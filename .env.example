# Local development: copy to .dev.vars for Wrangler, or .env.local for Next.
# D1 (DB), R2 (MEDIA) and ASSETS are Wrangler bindings, not secret strings.
APP_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a random secret of at least 32 characters; production Workers Secret.
MEDIA_SIGNING_SECRET=
# Video models: Kie Wan 3.0, Seedance 2.0 and Seedance 2.0 Fast.
# Apply migrations/0005_reference_uploads.sql before releasing sound/motion controls.
# APP_URL must be a public HTTPS origin in production so Kie can fetch template media.
KIE_API_KEY=
# Exact Kie output CDN hosts. Add only verified hosts returned by your account.
KIE_MEDIA_HOSTS=tempfile.aiquickdraw.com
# Music and video tasks submitted before the Kie switch still use APIMart.
APIMART_API_KEY=
# Required for video generation. Server-side SeeAPI content moderation key.
SEEAPI_API_KEY=
# Exact HTTPS CDN hostnames observed in your APIMart results, comma separated.
# Required before paid generation. No wildcard or arbitrary external URLs.
APIMART_MEDIA_HOSTS=
# Test and production use different merchant RSA private keys.
# Store PEM in a Worker secret; literal \n PEM escapes are supported by the SDK.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_MODE=test
WAFFO_STORE_ID=
WAFFO_PRODUCT_STARTER=
WAFFO_PRODUCT_CREATOR=
WAFFO_PRODUCT_PRO=
WAFFO_PRODUCT_BUSINESS=
