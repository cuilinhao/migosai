# Local development: copy to .dev.vars for Wrangler, or .env.local for Next.
# D1 (DB), R2 (MEDIA) and ASSETS are Wrangler bindings, not secret strings.
APP_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One Tap reuses GOOGLE_CLIENT_ID. Add APP_URL (origin only) to the Google
# web client's Authorized JavaScript origins. Keep the existing OAuth redirect:
# APP_URL/api/auth/callback/google. Client secret is never sent to the browser.
# Apply migrations/0006_email_and_one_tap_auth.sql before releasing email/One Tap auth.
# Email/password registration needs DB + APP_URL; no email delivery service is used.
# Generate a random secret of at least 32 characters; production Workers Secret.
MEDIA_SIGNING_SECRET=
# Video models: Kie Wan 3.0, Seedance 2.0 and Seedance 2.0 Fast.
# Apply migrations/0005_reference_uploads.sql before releasing sound/motion controls.
# APP_URL must be a public HTTPS origin in production so Kie can fetch template media.
KIE_API_KEY=
# Exact Kie output CDN hosts. Add only verified hosts returned by your account.
KIE_MEDIA_HOSTS=tempfile.aiquickdraw.com
# Music and video tasks submitted before the Kie switch still use APIMart.
APIMART_API_KEY=
# Required for video generation. Server-side SeeAPI content moderation key.
SEEAPI_API_KEY=
# Exact HTTPS CDN hostnames observed in your APIMart results, comma separated.
# Required before paid generation. No wildcard or arbitrary external URLs.
APIMART_MEDIA_HOSTS=
# New checkout provider: stripe or waffo. Unset retains historical Waffo compatibility.
# Stripe is one-time Checkout only. A publishable browser key is not needed.
PAYMENT_PROVIDER=stripe
# Use test with sk_test_/rk_test_; live with sk_live_/rk_live_. Never mix environments.
STRIPE_MODE=test
# Store these as Worker secrets; keep test and live endpoint secrets separate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required fixed one_time USD Prices from the same Stripe account and mode:
# Starter $9.90 / 300 credits; Creator $29.90 / 1,200; Pro $49.90 / 2,200;
# Business $99.90 / 5,000. No recurring Prices, coupons or variable amounts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/stripe (snapshot events).
# Subscribe: checkout.session.completed, checkout.session.async_payment_succeeded,
# charge.refunded, refund.created, refund.updated, refund.failed,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed.
# Webhook failures must be retried. Refund/dispute events flag manual review only.
# Existing Waffo orders and its webhook continue to use these historical credentials.
# Test and production use different merchant RSA private keys.
# Store PEM in a Worker secret; literal \n PEM escapes are supported by the SDK.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_MODE=test
WAFFO_STORE_ID=
WAFFO_PRODUCT_STARTER=
WAFFO_PRODUCT_CREATOR=
WAFFO_PRODUCT_PRO=
WAFFO_PRODUCT_BUSINESS=
