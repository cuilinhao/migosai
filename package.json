{
  "name": "migosai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply migosai --local",
    "db:remote": "wrangler d1 migrations apply migosai --remote"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "@opennextjs/cloudflare": "1.20.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@waffo/pancake-ts": "^0.25.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.25.4",
    "miniflare": "5.20261001.0-alpha",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
