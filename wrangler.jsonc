{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migosai",
  "main": "worker.ts",
  "account_id": "8021c9867ba6881cf688f0a25af0d32f",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "migosai"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "migosai",
      "database_id": "a49494ff-54a4-40eb-a7c2-d1e8ad7f487c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "migosai-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://migosai.design",
    "PAYMENT_PROVIDER": "stripe",
    "STRIPE_MODE": "live",
    "STRIPE_PRICE_STARTER": "price_1UMRzp9IlL4CIeBl9E1a7Qyl",
    "STRIPE_PRICE_CREATOR": "price_1UMS0f9IlL4CIeBlkVqz536C",
    "STRIPE_PRICE_PRO": "price_1UMS1N9IlL4CIeBl5K9zRWEy",
    "STRIPE_PRICE_BUSINESS": "price_1UMS3X9IlL4CIeBlFNf4NK88",
    "WAFFO_MODE": "prod",
    "WAFFO_MERCHANT_ID": "MER_0bgzn7efD1clpUtkReYznH",
    "WAFFO_STORE_ID": "STO_4ZOpv7dTwwVXkBd4b2tsNr",
    "WAFFO_PRODUCT_STARTER": "PROD_1wvkxxVnjVU2t1txQtLzBD",
    "WAFFO_PRODUCT_CREATOR": "PROD_6PdKlCbO19s7emXrKxpiVZ",
    "WAFFO_PRODUCT_PRO": "PROD_7IpB2s4ptadpNtlnDNmgEH",
    "WAFFO_PRODUCT_BUSINESS": "PROD_1ZAixY4b2O5H31tNjX9Ke2",
    "APIMART_MEDIA_HOSTS": "getapib.org",
    "KIE_MEDIA_HOSTS": "tempfile.aiquickdraw.com",
    "FAL_MEDIA_HOSTS": "fal.media,v3.fal.media,v3b.fal.media",
    "STRIPE_PRICE_MONTHLY_LITE": "price_1UTKmg9IlL4CIeBlTz3v0x0O",
    "STRIPE_PRICE_YEARLY_LITE": "price_1UTKmh9IlL4CIeBlQeS2IyKx",
    "STRIPE_PRICE_MONTHLY_STANDARD": "price_1UTKmh9IlL4CIeBlhiC185aT",
    "STRIPE_PRICE_YEARLY_STANDARD": "price_1UTKmi9IlL4CIeBlTLvOQq2I",
    "STRIPE_PRICE_MONTHLY_PRO": "price_1UTKmj9IlL4CIeBlMOlDgulA",
    "STRIPE_PRICE_YEARLY_PRO": "price_1UTKmj9IlL4CIeBlx82I4aAm",
    "STRIPE_PRICE_MONTHLY_ELITE_15000": "price_1UTKmk9IlL4CIeBltTX9qqbG",
    "STRIPE_PRICE_YEARLY_ELITE_15000": "price_1UTKmk9IlL4CIeBlfuW5QPzk",
    "STRIPE_PRICE_MONTHLY_ELITE_25000": "price_1UTKml9IlL4CIeBl7eTfkyKY",
    "STRIPE_PRICE_YEARLY_ELITE_25000": "price_1UTKml9IlL4CIeBlFXGmnRNB",
    "STRIPE_PRICE_MONTHLY_ELITE_40000": "price_1UTKmm9IlL4CIeBla3Wu4q0J",
    "STRIPE_PRICE_YEARLY_ELITE_40000": "price_1UTKmm9IlL4CIeBlHfCLi5qq",
    "STRIPE_PRICE_MONTHLY_ELITE_60000": "price_1UTKmn9IlL4CIeBlbUXpkGG2",
    "STRIPE_PRICE_YEARLY_ELITE_60000": "price_1UTKmo9IlL4CIeBlrVGHdOAK",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_1UTKmo9IlL4CIeBlWqCb3nmG"
  },
  "routes": [
    {
      "pattern": "migosai.design/*",
      "zone_name": "migosai.design"
    },
    {
      "pattern": "www.migosai.design/*",
      "zone_name": "migosai.design"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
